# basic_storage — ObjectStorage + RelationalDbms (mixed.ts spans two vendors)
#
# Copy this file to .env, fill in the blanks, then run:
#   cp .sample.env .env && ./deploy.sh azure
#
# .env is git-ignored. Never commit real credentials.

# --- Fractal Cloud service account (required) ---

# Service account client id.
SERVICE_ACCOUNT_ID=

# Service account client secret.
SERVICE_ACCOUNT_SECRET=

# --- Bounded context ---

# Required. UUID of the personal account owning the bounded context.
OWNER_ID=

# Optional. Bounded context name. Default: reusable-templates.
BC_NAME=reusable-templates

# Optional. Environment the LiveSystem deploys into. Default: dev.
ENVIRONMENT_NAME=dev

# --- Deployment ---

# Optional. wait (default) blocks until the LiveSystem is Active and logs
# each poll; fire-and-forget submits silently and returns immediately.
DEPLOY_MODE=wait
