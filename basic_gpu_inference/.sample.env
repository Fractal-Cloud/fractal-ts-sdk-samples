# basic_gpu_inference — GPU VM self-hosting vLLM + results bucket + Unmanaged AI
#
# Copy this file to .env, fill in the blanks, then run:
#   cp .sample.env .env && ./deploy.sh gcp
#
# .env is git-ignored. Never commit real credentials.

# --- Fractal Cloud service account (required) ---

# Service account client id.
SERVICE_ACCOUNT_ID=

# Service account client secret.
SERVICE_ACCOUNT_SECRET=

# --- Bounded context ---

# Required. UUID of the personal account owning the bounded context.
OWNER_ID=

# Optional. Bounded context name. Default: wizard.
BC_NAME=wizard

# Optional. Environment the LiveSystem deploys into. Default: dev.
ENVIRONMENT_NAME=dev

# --- Deployment ---

# Optional. wait (default) blocks until the LiveSystem is Active and logs
# each poll; fire-and-forget submits silently and returns immediately.
DEPLOY_MODE=wait

# --- basic_gpu_inference specific ---

# Optional — GCP region for every offer. Default: us-central1.
REGION=us-central1

# Optional — boot image for the GPU VM. Defaults to the image baked
# into src/live_system.ts.
IMAGE_LINK=

# Optional — email of a GCP service account to attach to the VM so it
# reaches Cloud Storage and Secret Manager without injected keys.
VM_SERVICE_ACCOUNT=
