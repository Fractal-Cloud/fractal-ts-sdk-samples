# basic_environment — Management + operational Environment, then a LiveSystem into it
#
# Copy this file to .env, fill in the blanks, then run:
#   cp .sample.env .env && ./deploy.sh
#
# .env is git-ignored. Never commit real credentials.

# --- Fractal Cloud service account (required) ---

# Service account client id.
SERVICE_ACCOUNT_ID=

# Service account client secret.
SERVICE_ACCOUNT_SECRET=

# --- Bounded context ---

# Required. UUID of the personal account owning the bounded context.
OWNER_ID=

# Optional. Bounded context name. Default: reusable-templates.
BC_NAME=reusable-templates

# --- Deployment ---

# Optional. wait (default) blocks until the LiveSystem is Active and logs
# each poll; fire-and-forget submits silently and returns immediately.
DEPLOY_MODE=wait

# --- basic_environment specific ---

# How the cloud agent authenticates to Azure: sp (default) or oidc.
AZURE_CLOUD_AGENT_AUTH=sp

# Azure tenant hosting both subscriptions.
AZURE_TENANT_ID=

# Subscription the management environment (cloud agent) runs in.
AZURE_MANAGEMENT_SUBSCRIPTION_ID=

# Subscription the operational environment deploys workloads into.
AZURE_OPERATIONAL_SUBSCRIPTION_ID=

# Service principal / OIDC app the cloud agent authenticates as.
AZURE_SP_CLIENT_ID=

# Required when AZURE_CLOUD_AGENT_AUTH=sp. Leave empty for oidc.
AZURE_SP_CLIENT_SECRET=

# Optional — PEM private key registered as the default CI/CD profile.
# When empty the environment is created without a CI/CD profile.
SSH_PRIVATE_KEY=

# Optional — passphrase for SSH_PRIVATE_KEY.
SSH_PASSPHRASE=

# Optional — value stored as the `db-password` environment secret.
# When empty no secret is created.
DB_PASSWORD=
