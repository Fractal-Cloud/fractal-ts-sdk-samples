# basic_environment — Management + operational Environment, then a LiveSystem into it
#
# Copy this file to .env, fill in the blanks, then run:
#   cp .sample.env .env && ./deploy.sh
#
# .env is git-ignored. Never commit real credentials.
#
# Quote any value that contains spaces or '#'. Only the matching outer pair of
# quotes is removed. Inline comments are NOT stripped from a value ('#' is a legal
# secret character), so keep comments on their own line.
#
# Exactly one kind of value may span several lines: a PEM block, whose opening
# line must be the armor itself (-----BEGIN ...-----). Any other unquoted-looking
# or unterminated value is refused on the spot rather than absorbing the lines
# after it — absorbing them is how a credential on a later line ended up inside
# an unrelated variable.
#
# Text after a closing quote, an unterminated quote, a line inside a PEM block
# that is not PEM content, and the same key assigned twice are all hard errors
# naming the .env line by number, never its content.
#
# This file holds a credential and it sets environment variables that npm, tsc
# and node inherit. Keep it private:  chmod 600 .env

# --- Fractal Cloud service account (required) ---

# Service account client id.
SERVICE_ACCOUNT_ID=

# Service account client secret.
SERVICE_ACCOUNT_SECRET=

# --- Bounded context ---

# Required. UUID of the personal account owning the bounded context.
OWNER_ID=

# Optional. Bounded context name. Default: reusable-templates.
BC_NAME=reusable-templates

# --- Deployment ---

# Optional. wait (default) blocks until the LiveSystem is Active and logs
# each poll; fire-and-forget submits silently and returns immediately.
DEPLOY_MODE=wait

# --- basic_environment specific ---

# How the cloud agent authenticates to Azure: sp (default) or oidc.
AZURE_CLOUD_AGENT_AUTH=sp

# Azure tenant hosting both subscriptions.
AZURE_TENANT_ID=

# Subscription the management environment (cloud agent) runs in.
AZURE_MANAGEMENT_SUBSCRIPTION_ID=

# Subscription the operational environment deploys workloads into.
AZURE_OPERATIONAL_SUBSCRIPTION_ID=

# Service principal / OIDC app the cloud agent authenticates as.
AZURE_SP_CLIENT_ID=

# Required when AZURE_CLOUD_AGENT_AUTH=sp. Leave empty for oidc.
AZURE_SP_CLIENT_SECRET=

# Optional — PEM private key registered as the default CI/CD profile.
# When empty the environment is created without a CI/CD profile.
#
# A PEM key is MULTI-LINE, so it must be double-quoted: the closing quote ends
# the value and every newline in between is carried through verbatim. Paste it
# exactly as generated, for example:
#
#   SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
#   b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAA...
#   -----END OPENSSH PRIVATE KEY-----"
#
# Pasting it UNQUOTED is rejected with a line number rather than silently
# truncated to its first line. When injecting from a CI secret store that cannot
# hold real newlines, the single-line form with literal \n separators also works.
SSH_PRIVATE_KEY=

# Optional — passphrase for SSH_PRIVATE_KEY.
SSH_PASSPHRASE=

# Optional — value stored as the `db-password` environment secret.
# When empty no secret is created.
DB_PASSWORD=
